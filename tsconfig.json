{
  // Type-checks the plain JavaScript with TypeScript, in strict mode. Nothing is compiled:
  // the game still ships as the .js files themselves. Run with: npm run typecheck
  // (tools/typecheck.mjs), which also allows a shrinking list of older files that
  // only pass the non-strict check so far.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*.js"]
}
