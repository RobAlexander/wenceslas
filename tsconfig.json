{
  // Type-checks the plain JavaScript with TypeScript, in strict mode. Nothing is compiled:
  // the game still ships as the .js files themselves. Types are given in JSDoc comments.
  // Run with: npm run typecheck
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*.js"]
}
